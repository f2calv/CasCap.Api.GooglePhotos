{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Console sample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/samples/ConsoleApp/bin/Release/net10.0/ConsoleApp.dll",
            "args": ["${input:mediaPath}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "logging": {
                "moduleLoad": false,
                "processExit": false
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ],
    "inputs": [
        {
            "id": "mediaPath",
            "type": "promptString",
            "description": "Path to a photo or video to upload"
        }
    ]
}
